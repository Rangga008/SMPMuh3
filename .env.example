# ============================================================
# SMP Muhammadiyah 3 — School Platform
# Copy this file to .env and fill in values for your environment.
# NEVER commit a real .env file.
# ============================================================

NODE_ENV=development

# ---------- Application URLs & ports (development) ----------
# Frontends (Next.js)
PUBLIC_WEB_PORT=3000
PUBLIC_WEB_URL=http://localhost:3000
SPMB_PORT=3001
SPMB_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
OPERATIONAL_PORT=3002
OPERATIONAL_URL=http://localhost:3002
CBT_PORT=3003
CBT_URL=http://localhost:3003

# Backend API (NestJS)
API_PORT=4000
API_URL=http://localhost:4000

# Production domains (reference only — used in deploy configs)
# PUBLIC_WEB_DOMAIN=www.smpmuh3bdg.sch.id
# SPMB_DOMAIN=spmb.smpmuh3bdg.sch.id
# OPERATIONAL_DOMAIN=admin.smpmuh3bdg.sch.id
# CBT_DOMAIN=cbt.smpmuh3bdg.sch.id

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smpmuh3
POSTGRES_PASSWORD=change_me_in_.env
POSTGRES_DB=smpmuh3
DATABASE_URL=postgresql://smpmuh3:change_me_in_.env@localhost:5432/smpmuh3?schema=public

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------- RabbitMQ ----------
RABBITMQ_USER=smpmuh3
RABBITMQ_PASSWORD=change_me_in_.env
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://smpmuh3:change_me_in_.env@localhost:5672

# ---------- S3-compatible object storage (adobe/s3mock in dev) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=change_me_in_.env
S3_BUCKET=smpmuh3-dev
S3_FORCE_PATH_STYLE=true

# ---------- Authentication ----------
# Secrets below are PLACEHOLDERS. Generate real values per environment.
JWT_ACCESS_SECRET=replace_with_random_64_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_random_64_chars
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost

# ---------- Initial admin seed (development) ----------
# Used by `pnpm --filter @smpmuh3/api prisma:seed`. If unset, no admin user
# is created. These are LOCAL DEV placeholders — use strong values elsewhere.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# ---------- CORS ----------
# Comma-separated list of allowed origins for the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# ---------- Integrations (placeholders — NOT implemented yet) ----------
# Dapodik / ARKAS are external systems. Integration layers are deferred
# to Phase 09. Do not put real credentials here until then.
# DAPODIK_BASE_URL=
# DAPODIK_TOKEN=
# ARKAS_BASE_URL=
# ARKAS_TOKEN=
# PAYMENT_GATEWAY_BASE_URL=
# PAYMENT_GATEWAY_KEY=
MOCK_PAYMENT_SECRET=mock_dev_secret
