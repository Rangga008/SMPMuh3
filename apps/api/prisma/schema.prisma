// School platform — core schema (Phase 01)
// Conventions: docs/development/conventions.md (snake_case tables/columns,
// PascalCase models, uuid ids, created_at/updated_at everywhere).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity & access ----------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String?    @unique
  phone        String?    @unique
  passwordHash String     @map("password_hash")
  name         String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  roles         UserRole[]
  refreshTokens RefreshToken[]
  documents     Document[]     @relation("OwnedDocuments")
  uploads       Document[]     @relation("UploadedDocuments")
  notifications Notification[]
  auditLogs     AuditLog[]
  candidates    Candidate[]
  registrations Registration[]
  passwordResetTokens PasswordResetToken[]
  students      Student[]      @relation("StudentParent")
  employee      Employee?
  financeTx     FinanceTransaction[]
  bankIncomes   BankIncome[]
  savingsEntries SavingsEntry[]
  expenses      Expense[]      @relation("ExpenseCreator")
  titipanEntries TitipanEntry[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- School core ----------

model School {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  code          String?  @unique
  tagline       String?
  address       String?
  phone         String?
  whatsapp      String?
  email         String?
  headmaster    String?
  headmasterNip String?  @map("headmaster_nip")
  npsn          String?  // Nomor Pokok Satuan Pendidikan Nasional (NPSN) sekolah
  headmasterSignatureUrl String? @map("headmaster_signature_url")
  logoUrl       String?  @map("logo_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("schools")
}

model AcademicYear {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique // e.g. "2026/2027"
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  isActive    Boolean  @default(false) @map("is_active")
  titipanOpen Boolean  @default(false) @map("titipan_open") // terima pendaftar titipan (boleh tahun jauh)
  quota       Int?     // kuota penerimaan — null = tanpa batas
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  registrations Registration[]
  classes       Class[]
  enrollments   Enrollment[]
  assignments   TeachingAssignment[]
  assessments   Assessment[]
  waves         RegistrationWave[]
  formQuestions FormQuestion[]
  financeTx     FinanceTransaction[]
  financeBudgets FinanceBudget[]
  examRecords   SchoolExamRecord[]
  titipanEntries TitipanEntry[]
  semesters     Semester[]
  invoices      Invoice[]
  expenses      Expense[]
  payrollRuns   PayrollRun[]
  calendarEvents AcademicCalendarEvent[]
  scheduleBlocks ScheduleBlock[]
  examRooms     ExamRoom[]

  @@map("academic_years")
}

// ---------- SPMB (admission) ----------

enum Gender {
  MALE
  FEMALE
}

enum RegistrationStatus {
  DRAFT
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  FORM_FILLING
  SUBMITTED
  DOCUMENT_REVIEW
  NEEDS_REVISION
  VERIFIED
  AWAITING_FINAL_PAYMENT
  FINAL_PAYMENT_REVIEW
  SELECTION
  ACCEPTED
  REJECTED
  RE_REGISTRATION
  COMPLETED
}

model Candidate {
  id             String    @id @default(uuid()) @db.Uuid
  parentId       String    @map("parent_id") @db.Uuid
  name           String
  gender         Gender?
  birthPlace     String?   @map("birth_place")
  birthDate      DateTime? @map("birth_date") @db.Date
  nisn           String?
  nik            String?   // NIK calon murid — ikut ke Student saat diterima
  motherName     String?   @map("mother_name") // wajib sebelum submit formulir — sinkron dg data siswa
  previousSchool String?   @map("previous_school")
  address        String?
  tkaScore       Int?      @map("tka_score")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  parent        User          @relation(fields: [parentId], references: [id], onDelete: Cascade)
  registrations Registration[]
  student       Student?
  titipanEntries TitipanEntry[]

  @@index([parentId])
  @@map("candidates")
}

enum TitipanStatus {
  PENDING
  WAITING
  CODE_SENT
  REGISTERED
  CANCELLED
}

/**
 * Daftar titipan / waiting list SPMB. Ortu menitipkan anak untuk tahun
 * ajaran tertentu (boleh tahun jauh), lalu admin menerbitkan kode formulir
 * unik yang ditukar ortu menjadi pendaftaran resmi.
 * Sumber data bisa akun ortu (tertaut candidate) atau form publik (guest).
 */
model TitipanEntry {
  id             String        @id @default(uuid()) @db.Uuid
  academicYearId String        @map("academic_year_id") @db.Uuid
  waveId         String?       @map("wave_id") @db.Uuid // gelombang sasaran di TA tsb — opsional
  parentId       String?       @map("parent_id") @db.Uuid
  candidateId    String?       @map("candidate_id") @db.Uuid
  candidateName  String        @map("candidate_name")
  birthPlace     String?       @map("birth_place")
  birthDate      DateTime?     @map("birth_date") @db.Date
  address        String?
  previousSchool String?       @map("previous_school")
  guardianPhone  String?       @map("guardian_phone") // satu nomor HP ortu/wali — tujuan WA
  infoSource     String?       @map("info_source")
  queueNo        Int           @map("queue_no") // nomor antre per tahun ajaran — stabil, tidak berubah
  status         TitipanStatus @default(PENDING)
  formCode       String?       @unique @map("form_code")
  codeSentAt     DateTime?     @map("code_sent_at")
  codeSentBy     String?       @map("code_sent_by") @db.Uuid
  codeUsedAt     DateTime?     @map("code_used_at")
  registrationId String?       @map("registration_id") @db.Uuid
  note           String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id])
  wave         RegistrationWave? @relation(fields: [waveId], references: [id], onDelete: SetNull)
  parent       User?            @relation(fields: [parentId], references: [id], onDelete: SetNull)
  candidate    Candidate?       @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@unique([academicYearId, queueNo])
  @@index([academicYearId, status, queueNo])
  @@index([waveId])
  @@index([parentId])
  @@map("titipan_entries")
}

model RegistrationWave {
  id             String   @id @default(uuid()) @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  name           String // e.g. "Gelombang 1"
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  order          Int      @default(1)
  isActive       Boolean  @default(true) @map("is_active")
  psikotesAt     DateTime? @map("psikotes_at")
  psikotesNote   String?   @map("psikotes_note")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  registrations  Registration[]
  fees           WaveFee[]
  titipanEntries TitipanEntry[]

  @@unique([academicYearId, name])
  @@index([academicYearId, isActive])
  @@map("registration_waves")
}

/** Biaya SPMB yang di-set admin (pendaftaran, DSP, SPP, seragam). */
model SpmbFee {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique // registration | dsp | spp | seragam
  label     String
  amount    Int
  isActive  Boolean  @default(true) @map("is_active")
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("spmb_fees")
}

/** Override biaya per gelombang — key sama dengan SpmbFee.key; tanpa baris = pakai fee global. */
model WaveFee {
  waveId    String   @map("wave_id") @db.Uuid
  key       String // registration | dsp | dsp_dp | spp | seragam
  amount    Int
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wave RegistrationWave @relation(fields: [waveId], references: [id], onDelete: Cascade)

  @@id([waveId, key])
  @@map("wave_fees")
}

/** Aturan diskon DSP untuk jalur prestasi — di-set admin. */
model DiscountRule {
  id        String   @id @default(uuid()) @db.Uuid
  subType   String   @unique // akademik | tahfidz_2 | tahfidz_3plus | non_akademik | alumni_sdm | kustom
  label     String
  /** Grup jalur prestasi di formulir ortu: akademik | non_akademik | alumni_sdm. */
  category  String   @default("non_akademik")
  percent   Int      @default(0)
  minScore  Int?     @map("min_score") // syarat nilai rapor untuk akademik
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("discount_rules")
}

/** Pertanyaan formulir dinamis — di-set admin, diisi ortu. */
model FormQuestion {
  id             String   @id @default(uuid()) @db.Uuid
  academicYearId String?  @map("academic_year_id") @db.Uuid // null = berlaku semua tahun
  label          String
  helpText       String?  @map("help_text")
  fieldType      String   @default("text") @map("field_type") // text|textarea|date|number|select
  options        Json?    // string[] untuk fieldType=select
  required       Boolean  @default(false)
  order          Int      @default(0)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@index([isActive, order])
  @@map("form_questions")
}

model Registration {
  id              String             @id @default(uuid()) @db.Uuid
  number          String             @unique // e.g. "SPMB-2027-000123"
  candidateId     String             @map("candidate_id") @db.Uuid
  parentId        String             @map("parent_id") @db.Uuid
  academicYearId  String             @map("academic_year_id") @db.Uuid
  waveId          String?            @map("wave_id") @db.Uuid
  pathway         String
  pathwayDetail   String?            @map("pathway_detail") // sub-jalur prestasi
  status          RegistrationStatus @default(DRAFT)
  formAnswers     Json?              @map("form_answers") // {questionId: value}
  discountPercent Int                @default(0) @map("discount_percent")
  submittedAt     DateTime?          @map("submitted_at")
  revisionNote    String?            @map("revision_note")
  decisionNote    String?            @map("decision_note") // alasan diterima/ditolak
  psikotesAt      DateTime?          @map("psikotes_at")
  psikotesNote    String?            @map("psikotes_note")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  candidate    Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  parent       User              @relation(fields: [parentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear      @relation(fields: [academicYearId], references: [id])
  wave         RegistrationWave? @relation(fields: [waveId], references: [id])
  documents    Document[]
  invoices     Invoice[]
  installmentPlans InstallmentPlan[]

  // One registration per candidate per academic year.
  @@unique([candidateId, academicYearId])
  @@index([parentId, status])
  @@index([waveId])
  @@map("registrations")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------- Payments (SPMB fees) ----------

enum InvoiceStatus {
  OPEN
  PARTIAL
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SETTLED
  FAILED
  EXPIRED
  REFUNDED
}

/** Rencana angsuran — admin membuat N tagihan sekaligus. */
model InstallmentPlan {
  id             String   @id @default(uuid()) @db.Uuid
  registrationId String   @map("registration_id") @db.Uuid
  title          String
  totalAmount    Int      @map("total_amount")
  count          Int
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@index([registrationId])
  @@map("installment_plans")
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  number          String        @unique // e.g. "INV-2027-000123"
  registrationId  String?       @map("registration_id") @db.Uuid
  studentId       String?       @map("student_id") @db.Uuid
  planId          String?       @map("plan_id") @db.Uuid
  batchId         String?       @map("batch_id") @db.Uuid
  kind            String        @default("other") // registration_fee | dsp_dp | dsp | spp | seragam | kat | daftar_ulang | installment | other
  title           String
  amount          Int
  baseAmount      Int?          @map("base_amount") // sebelum diskon
  discountPercent Int           @default(0) @map("discount_percent")
  status          InvoiceStatus @default(OPEN)
  installmentNo   Int?          @map("installment_no")
  dueAt           DateTime?     @map("due_at")
  issuedAt        DateTime      @default(now()) @map("issued_at")
  paidAt          DateTime?     @map("paid_at")
  note            String?
  payerLabel      String?       @map("payer_label") // nama penanggung bayar (ortu/wali)
  academicYearId  String?       @map("academic_year_id") @db.Uuid
  semesterId      String?       @map("semester_id") @db.Uuid
  classId         String?       @map("class_id") @db.Uuid // kelas siswa saat tagihan dibuat (denormal untuk filter)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  registration Registration?  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  student      Student?       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan         InstallmentPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  batch        BillingBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  academicYear AcademicYear?  @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  semester     Semester?      @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  class        Class?         @relation(fields: [classId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payments     Payment[]
  allocations  PaymentAllocation[]

  @@index([registrationId])
  @@index([studentId, status])
  @@index([academicYearId, kind])
  @@map("invoices")
}

/** Rincian komponen dalam satu invoice — "300rb = 250 SPP + 50 DSP". */
model InvoiceItem {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  kind      String   @default("other") // spp | dsp | seragam | kat | daftar_ulang | pendaftaran | tabungan | other
  label     String
  amount    Int
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  invoice     Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceId       String        @map("invoice_id") @db.Uuid
  provider        String // "mock" | "manual" — adapter key
  providerRef     String?       @unique @map("provider_ref") // idempotency key
  method          String? // "transfer" | "cash" | "mock_transfer"
  amount          Int
  status          PaymentStatus @default(PENDING)
  proofDocumentId String?       @map("proof_document_id") @db.Uuid
  verifiedBy      String?       @map("verified_by") @db.Uuid
  verifiedAt      DateTime?     @map("verified_at")
  verifyNote      String?       @map("verify_note")
  rawPayload      Json?         @map("raw_payload")
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  cashAccountId  String?       @map("cash_account_id") @db.Uuid

  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  proofDocument  Document? @relation("PaymentProof", fields: [proofDocumentId], references: [id], onDelete: SetNull)
  cashAccount    CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  receipts       Receipt[]
  financeTx      FinanceTransaction?
  allocations    PaymentAllocation[]

  @@index([invoiceId])
  @@map("payments")
}

/**
 * Alokasi satu pembayaran ke komponen/invoice — pembayaran terpisah
 * ("300rb: 250 SPP + 50 DSP") dan cicilan parsial harian.
 */
model PaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  itemId    String?  @map("item_id") @db.Uuid
  amount    Int
  createdAt DateTime @default(now()) @map("created_at")

  payment  Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice  Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item     InvoiceItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  financeTx FinanceTransaction?

  @@index([invoiceId])
  @@index([paymentId])
  @@map("payment_allocations")
}

/** Satu run penagihan massal (mis. SPP November seluruh kelas 7). */
model BillingBatch {
  id               String   @id @default(uuid()) @db.Uuid
  kind             String // spp | daftar_ulang | kat | seragam | other
  title            String
  itemLabel        String   @map("item_label")
  amount           Int // nominal per siswa
  academicYearId   String?  @map("academic_year_id") @db.Uuid
  semesterId       String?  @map("semester_id") @db.Uuid
  classId          String?  @map("class_id") @db.Uuid
  gradeLevel       Int?     @map("grade_level")
  dueAt            DateTime? @map("due_at")
  generatedCount   Int      @map("generated_count")
  skippedCount     Int      @default(0) @map("skipped_count")
  createdBy        String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  invoices Invoice[]

  @@index([academicYearId, kind])
  @@map("billing_batches")
}

/** Tabungan siswa — setor/tarik, posting ke kas. Saldo = ΣIN − ΣOUT. */
model SavingsEntry {
  id            String        @id @default(uuid()) @db.Uuid
  studentId     String        @map("student_id") @db.Uuid
  direction     CashDirection
  amount        Int
  note          String?
  cashAccountId String?       @map("cash_account_id") @db.Uuid
  occurredAt    DateTime      @default(now()) @map("occurred_at")
  recordedById  String?       @map("recorded_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cashAccount  CashAccount?  @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  recordedBy   User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([studentId, occurredAt])
  @@map("savings_entries")
}

/** Kwitansi pembayaran — dikirim ke nomor HP ortu (adapter WA menyusul). */
model Receipt {
  id         String   @id @default(uuid()) @db.Uuid
  number     String   @unique // e.g. "KWT-2027-000123"
  paymentId  String?  @map("payment_id") @db.Uuid
  refType    String?  @map("ref_type") // expense | transaction — kwitansi non-pembayaran
  refId      String?  @map("ref_id") @db.Uuid
  channel    String   @default("whatsapp") // whatsapp | sms | print
  recipient  String // nomor HP tujuan / nama penerima cetak
  body       String // isi kwitansi (teks)
  status     String   @default("QUEUED") // QUEUED | SENT | FAILED | PRINTED
  sentAt     DateTime? @map("sent_at")
  issuedBy   String?  @map("issued_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("receipts")
}

// ---------- Keuangan (internal — lepas dari ARKAS) ----------

enum FinanceTxType {
  INCOME
  EXPENSE
}

/**
 * Kategori transaksi — pemasukan (DSP/SPP/seragam/dst) & pengeluaran.
 * `standardGroup` = pengelompokan 8 Standar Nasional Pendidikan untuk
 * kategori pengeluaran (ISI|PROSES|KELULUSAN|TENAGA|SARANA|PENGELOLAAN|
 * PEMBIAYAAN|PENILAIAN), null = tanpa standar.
 */
model FinanceCategory {
  id            String         @id @default(uuid()) @db.Uuid
  key           String         @unique // e.g. "spmb_dsp"
  name          String
  type          FinanceTxType
  standardGroup String?        @map("standard_group")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")

  transactions FinanceTransaction[]
  budgets      FinanceBudget[]
  bankIncomes  BankIncome[]
  expenses     Expense[]

  @@map("finance_categories")
}

/**
 * Transaksi keuangan. `source` = "manual" untuk catatan bendahara,
 * "spmb" untuk pemasukan otomatis dari pembayaran SPMB yang diverifikasi.
 * `paymentId` menjaga idempotensi (1 pembayaran → 1 transaksi).
 */
model FinanceTransaction {
  id             String         @id @default(uuid()) @db.Uuid
  type           FinanceTxType
  categoryId     String         @map("category_id") @db.Uuid
  amount         Int
  occurredAt     DateTime       @map("occurred_at")
  description    String?
  source         String         @default("manual") // manual | spmb | billing | expense | payroll
  paymentId      String?        @unique @map("payment_id") @db.Uuid
  paymentAllocationId String?   @unique @map("payment_allocation_id") @db.Uuid
  expenseAllocationId String?   @unique @map("expense_allocation_id") @db.Uuid
  payrollItemId    String?      @unique @map("payroll_item_id") @db.Uuid
  cashAccountId  String?        @map("cash_account_id") @db.Uuid
  academicYearId String?        @map("academic_year_id") @db.Uuid
  recordedById   String?        @map("recorded_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  category     FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  payment      Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  paymentAllocation PaymentAllocation? @relation(fields: [paymentAllocationId], references: [id], onDelete: SetNull)
  expenseAllocation ExpenseAllocation? @relation(fields: [expenseAllocationId], references: [id], onDelete: SetNull)
  payrollItem   PayrollItem?   @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)
  cashAccount  CashAccount?    @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  academicYear AcademicYear?   @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  recordedBy   User?           @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([type, occurredAt])
  @@index([academicYearId])
  @@map("finance_transactions")
}

/** Anggaran per kategori per tahun ajaran — dibandingkan realisasi. */
model FinanceBudget {
  id             String   @id @default(uuid()) @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  amount         Int
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  category     FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, categoryId])
  @@map("finance_budgets")
}

enum CashAccountType {
  CASH
  BANK
}

/** Akun kas — semua arus uang bermuara ke sini (tunai, BOS, RMP, rekening bank). */
model CashAccount {
  id             String          @id @default(uuid()) @db.Uuid
  key            String          @unique // tunai | bos | rmp | bank_bsi | ...
  name           String
  type           CashAccountType @default(CASH)
  openingBalance Int             @default(0) @map("opening_balance")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  movements    CashMovement[]
  transactions FinanceTransaction[]
  payments     Payment[]
  bankIncomes  BankIncome[]
  savings      SavingsEntry[]
  expenseAllocations ExpenseAllocation[]
  loans              Loan[]            @relation("LoanCashSource")
  payrollRuns        PayrollRun[]

  @@map("cash_accounts")
}

enum CashDirection {
  IN
  OUT
}

/**
 * Gerakan kas — saldo = openingBalance + ΣIN − ΣOUT (tidak disimpan, tak bisa selisih).
 * refType+refId menunjuk sumber: 'finance_tx' | 'payment' | 'bank_income' | 'expense' |
 * 'payroll' | 'savings' | 'manual'.
 */
model CashMovement {
  id            String        @id @default(uuid()) @db.Uuid
  cashAccountId String        @map("cash_account_id") @db.Uuid
  direction     CashDirection
  amount        Int
  refType       String        @default("manual") @map("ref_type")
  refId         String?       @map("ref_id") @db.Uuid
  description   String?
  occurredAt    DateTime      @map("occurred_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  account CashAccount @relation(fields: [cashAccountId], references: [id], onDelete: Cascade)

  @@index([cashAccountId, occurredAt])
  @@index([refType, refId])
  @@map("cash_movements")
}

/** Buku bank — pemasukan via transfer (dari siapa, untuk apa, ke bank mana). */
model BankIncome {
  id            String   @id @default(uuid()) @db.Uuid
  cashAccountId String   @map("cash_account_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  senderName    String   @map("sender_name")
  purpose       String?  // untuk apa (mis. "SPP Nov a.n. Ahmad")
  amount        Int
  receivedAt    DateTime @map("received_at")
  txId          String?  @map("tx_id") @db.Uuid // transaksi hasil posting
  recordedById  String?  @map("recorded_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  account    CashAccount      @relation(fields: [cashAccountId], references: [id], onDelete: Cascade)
  category   FinanceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recordedBy User?            @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([cashAccountId, receivedAt])
  @@map("bank_incomes")
}

enum ExpenseStatus {
  POSTED
  VOID
}

/**
 * Dokumen pengeluaran — ATK, listrik, sewa panggung, honor panitia, dst.
 * Dana bisa ditarik dari beberapa kas sekaligus (ExpenseAllocation).
 */
model Expense {
  id             String        @id @default(uuid()) @db.Uuid
  number         String        @unique // e.g. "EXP-2026-000123"
  occurredAt     DateTime      @map("occurred_at")
  vendor         String?       // toko/penerima
  description    String        // uraian pengeluaran
  categoryId     String        @map("category_id") @db.Uuid
  academicYearId String?       @map("academic_year_id") @db.Uuid
  totalAmount    Int           @map("total_amount")
  note           String?
  documentId     String?       @map("document_id") @db.Uuid // nota/kwitansi
  status         ExpenseStatus @default(POSTED)
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  category     FinanceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  academicYear AcademicYear?        @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  creator      User?                @relation("ExpenseCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  allocations  ExpenseAllocation[]

  @@index([occurredAt])
  @@index([categoryId])
  @@map("expenses")
}

/** Penarikan dana satu pengeluaran dari satu kas — Σ = expense.totalAmount. */
model ExpenseAllocation {
  id            String   @id @default(uuid()) @db.Uuid
  expenseId     String   @map("expense_id") @db.Uuid
  cashAccountId String   @map("cash_account_id") @db.Uuid
  amount        Int
  createdAt     DateTime @default(now()) @map("created_at")

  expense    Expense       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  cashAccount CashAccount  @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  financeTx  FinanceTransaction?

  @@index([expenseId])
  @@index([cashAccountId])
  @@map("expense_allocations")
}

// ---------- Payroll ----------

enum EmpAttendanceStatus {
  HADIR
  TELAT
  IZIN
  SAKIT
  ALPHA
}

enum HonorPeriod {
  MONTHLY     // rutin tiap bulan (jabatan, wali kelas)
  PER_SESSION // per sesi/pertemuan (piket, eskul, mamin)
  ONE_TIME    // sekali (honor panitia per kegiatan)
}

enum LoanSource {
  KASBON     // pinjam ke sekolah — uang keluar dari kas saat dibuat
  KOOPERASI  // koperasi sekolah
  EKSTERNAL  // koperasi luar — sekolah hanya memotong gaji
}

enum LoanStatus {
  ACTIVE
  PAID_OFF
  CANCELLED
}

enum PayrollStatus {
  DRAFT      // sedang dihitung, bisa diubah
  FINALIZED  // dikunci, slip final
  PAID       // sudah dibayar — gerakan kas tercatat
  VOID
}

enum PayrollLineKind {
  BASE       // gaji wajib (jam wajib × minggu)
  TRANSPORT  // transport (jam wajib × minggu)
  HONOR      // honor tambahan (jabatan, wali, piket, eskul, mamin, panitia)
  DEDUCTION  // potongan (infak, PDM, tabungan, dll)
  LOAN       // angsuran pinjaman/kasbon/koperasi
  PENSION    // potongan dana pensiun
  BOS_HONOR  // honor BOS non-sertifikasi (dibayar sekolah)
}

/** Golongan masa kerja — tarif per jam wajib & transport. */
model PayScale {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  // e.g. "0–4 tahun"
  minYears      Int     @map("min_years")
  maxYears      Int?    @map("max_years") // null = tak terbatas
  hourlyRate    Int     @map("hourly_rate")    // per jam wajib
  transportRate Int     @map("transport_rate") // per jam transport
  isActive      Boolean @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@map("pay_scales")
}

/** Absensi harian guru — status + menit mengajar yang dihitung. */
model EmployeeAttendance {
  id              String          @id @default(uuid()) @db.Uuid
  employeeId      String          @map("employee_id") @db.Uuid
  date            DateTime        @db.Date
  status          EmpAttendanceStatus
  teachingMinutes Int             @default(0) @map("teaching_minutes")
  note            String?
  checkInAt       DateTime?       @map("check_in_at")  // tap masuk (mesin/manual)
  checkOutAt      DateTime?       @map("check_out_at") // tap pulang
  lateMinutes     Int             @default(0) @map("late_minutes") // menit lewat jam masuk (shift/global)
  source          AttendanceSource @default(MANUAL)
  recordedBy      String?         @map("recorded_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@map("employee_attendances")
}

enum AttendanceSource {
  DEVICE // tap dari mesin fingerprint/face
  IMPORT // file attlog yang diunggah
  MANUAL // entri manual oleh TU/keuangan
  SELFIE // absen foto+geolokasi oleh pegawai sendiri
}

enum DeviceMode {
  ICLOCK // mesin push ke server (ADMS/iClock) — disarankan
  PULL   // server menarik log via TCP (port 4370)
  MANUAL // hanya lewat unggah file
}

/** Perangkat absensi biometrik yang tersambung ke sistem. */
model AttendanceDevice {
  id         String          @id @default(uuid()) @db.Uuid
  name       String
  serial     String          @unique // SN mesin — kunci autentikasi iClock
  mode       DeviceMode      @default(ICLOCK)
  host       String?                   // IP mesin untuk mode PULL
  port       Int             @default(4370)
  commKey    String?         @map("comm_key") // comm password mesin (PULL)
  location   String?
  isActive   Boolean         @default(true) @map("is_active")
  lastSeenAt DateTime?       @map("last_seen_at") // handshake terakhir
  createdAt  DateTime        @default(now()) @map("created_at")

  logs AttendanceLog[]

  @@map("attendance_devices")
}

/** Satu tap (check-in/out) mentah dari mesin atau impor — dedup via deviceKey+pin+waktu. */
model AttendanceLog {
  id         String           @id @default(uuid()) @db.Uuid
  deviceKey  String           @map("device_key") // SN mesin, atau 'MANUAL'/'IMPORT'
  deviceId   String?          @map("device_id") @db.Uuid
  pin        String                                // user id di mesin
  punchedAt  DateTime         @map("punched_at")
  inOut      Int              @default(0) @map("in_out") // 0=masuk, 1=pulang (ZKTeco)
  employeeId String?          @map("employee_id") @db.Uuid // ter-resolve dari pin
  source     AttendanceSource @default(DEVICE)
  photoKey   String?          @map("photo_key") // S3 key foto selfie
  latitude   Float?           @map("latitude")
  longitude  Float?           @map("longitude")
  createdAt  DateTime         @default(now()) @map("created_at")

  device   AttendanceDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  employee Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([deviceKey, pin, punchedAt, inOut])
  @@index([employeeId, punchedAt])
  @@index([punchedAt])
  @@map("attendance_logs")
}

/** Pengaturan jadwal kerja untuk derivasi HADIR/TELAT dari tap mesin. */
/** Shift kerja pegawai — jam masuk/pulang per kelompok (pagi/siang/dll). */
model WorkShift {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   // e.g. "Pagi", "Siang"
  startMinute  Int      @map("start_minute")   // jam masuk (menit sejak 00:00)
  endMinute    Int      @map("end_minute")     // jam pulang
  lateAfter    Int      @default(10) @map("late_after")   // toleransi telat (menit)
  checkOutFrom Int      @map("check_out_from") // tap pulang sah mulai menit ini
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignments EmployeeShift[]

  @@map("work_shifts")
}

/** Penugasan shift ke pegawai — dayOfWeek -1 = semua hari (default), 0=Minggu…6=Sabtu. */
model EmployeeShift {
  id         String @id @default(uuid()) @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  shiftId    String @map("shift_id") @db.Uuid
  dayOfWeek  Int    @default(-1) @map("day_of_week")

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    WorkShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
  @@index([shiftId])
  @@map("employee_shifts")
}

/** Event kalender akademik — libur/kegiatan/ujian yang memengaruhi kalender mengajar. */
model AcademicCalendarEvent {
  id             String   @id @default(uuid()) @db.Uuid
  date           DateTime @db.Date
  title          String
  type           String   @default("KEGIATAN") // LIBUR | KEGIATAN | UJIAN | LAINNYA
  note           String?
  academicYearId String?  @map("academic_year_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@index([date])
  @@map("academic_calendar_events")
}

/** Pengaturan payroll global — potongan otomatis dari data absensi. */
model PayrollSetting {
  id                  String   @id @default("global")
  lateDeductionPerDay Int      @default(0) @map("late_deduction_per_day") // potongan per hari telat
  lateDeductionPerMin Int      @default(0) @map("late_deduction_per_min") // potongan per menit telat
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("payroll_settings")
}

model AttendanceSetting {
  id           String   @id @default("global")
  workStart    String   @default("07:00") @map("work_start")     // "HH:mm" — batas jam masuk
  lateAfter    Int      @default(10) @map("late_after")          // toleransi menit sebelum TELAT
  checkOutFrom String   @default("12:00") @map("check_out_from") // tap >= jam ini dihitung pulang
  autoDerive   Boolean  @default(true) @map("auto_derive")       // tap mesin → status harian
  schoolLat    Float?   @map("school_lat")   // titik lokasi sekolah (geofence selfie)
  schoolLng    Float?   @map("school_lng")
  radiusM      Int      @default(200) @map("radius_m") // radius absen selfie (meter)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("attendance_settings")
}

/** Tipe honor tambahan — jabatan, wali kelas, piket, eskul, mamin, panitia. */
model HonorType {
  id            String      @id @default(uuid()) @db.Uuid
  key           String      @unique
  name          String
  period        HonorPeriod
  defaultAmount Int         @default(0) @map("default_amount") // per bulan/sesi
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")

  honors EmployeeHonor[]

  @@map("honor_types")
}

/** Honor yang melekat ke pegawai — override nominal, sesi, dan masa berlaku. */
model EmployeeHonor {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  honorTypeId String    @map("honor_type_id") @db.Uuid
  amount      Int?      // null = pakai defaultAmount
  sessions    Int       @default(1) // utk PER_SESSION: sesi per bulan
  eventName   String?   @map("event_name") // utk ONE_TIME: nama kegiatan
  eventMonth  String?   @map("event_month") // utk ONE_TIME: "YYYY-MM"
  validFrom   String?   @map("valid_from") // "YYYY-MM" mulai berlaku
  validTo     String?   @map("valid_to")   // "YYYY-MM" akhir (null = terus)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  honorType HonorType @relation(fields: [honorTypeId], references: [id], onDelete: Restrict)

  @@index([employeeId, isActive])
  @@map("employee_honors")
}

/** Tipe potongan gaji — infak, PDM, kasbon, tabungan, pensiun. */
model DeductionType {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique
  name          String
  defaultAmount Int      @default(0) @map("default_amount")
  isRecurring   Boolean  @default(true) @map("is_recurring") // tiap bulan atau sekali
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  deductions EmployeeDeduction[]

  @@map("deduction_types")
}

model EmployeeDeduction {
  id              String   @id @default(uuid()) @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  deductionTypeId String   @map("deduction_type_id") @db.Uuid
  amount          Int?     // null = pakai defaultAmount
  month           String?  // "YYYY-MM" utk potongan sekali; null = tiap bulan
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deductionType DeductionType @relation(fields: [deductionTypeId], references: [id], onDelete: Restrict)

  @@index([employeeId, isActive])
  @@map("employee_deductions")
}

/** Pinjaman: kasbon sekolah / koperasi sekolah / koperasi luar (potong gaji). */
model Loan {
  id              String     @id @default(uuid()) @db.Uuid
  employeeId      String     @map("employee_id") @db.Uuid
  source          LoanSource
  principal       Int        // pokok pinjaman
  fee             Int        @default(0) // jasa total
  installments    Int        // jumlah angsuran
  monthlyAmount   Int        @map("monthly_amount") // angsuran per bulan (bisa diubah)
  remaining       Int        // sisa pokok+jasa yang belum dibayar
  startMonth      String     @map("start_month") // "YYYY-MM" mulai dipotong
  status          LoanStatus @default(ACTIVE)
  note            String?
  cashAccountId   String?    @map("cash_account_id") @db.Uuid // KASBON: kas sumber
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cashAccount CashAccount? @relation("LoanCashSource", fields: [cashAccountId], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@map("loans")
}

/** Buku dana pensiun per pegawai — akumulasi potongan pensiun. */
model PensionEntry {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  month        String   // "YYYY-MM"
  amount       Int
  payrollItemId String? @map("payroll_item_id") @db.Uuid
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, month])
  @@map("pension_entries")
}

/**
 * Satu siklus penggajian bulanan.
 * DRAFT → dihitung ulang bebas; FINALIZED → slip final; PAID → kas keluar.
 */
model PayrollRun {
  id             String        @id @default(uuid()) @db.Uuid
  month          String        // "YYYY-MM"
  academicYearId String?       @map("academic_year_id") @db.Uuid
  weeks          Int           @default(4) // jumlah minggu aktif bulan itu
  status         PayrollStatus @default(DRAFT)
  note           String?
  cashAccountId  String?       @map("cash_account_id") @db.Uuid // kas pembayar
  finalizedBy    String?       @map("finalized_by") @db.Uuid
  finalizedAt    DateTime?     @map("finalized_at")
  paidAt         DateTime?     @map("paid_at")
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")

  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  cashAccount  CashAccount?  @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  items        PayrollItem[]

  @@unique([month])
  @@map("payroll_runs")
}

/** Slip satu pegawai dalam satu run — rincian di PayrollItemLine. */
model PayrollItem {
  id              String   @id @default(uuid()) @db.Uuid
  runId           String   @map("run_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  workedMinutes   Int      @default(0) @map("worked_minutes")  // Σ menit hadir
  requiredMinutes Int      @default(0) @map("required_minutes") // jam wajib × minggu
  basePay         Int      @default(0) @map("base_pay")
  transportPay    Int      @default(0) @map("transport_pay")
  grossAmount     Int      @default(0) @map("gross_amount")
  deductionAmount Int      @default(0) @map("deduction_amount")
  netAmount       Int      @default(0) @map("net_amount")
  createdAt       DateTime @default(now()) @map("created_at")

  run      PayrollRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lines    PayrollItemLine[]
  financeTx FinanceTransaction?

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@map("payroll_items")
}

model PayrollItemLine {
  id        String          @id @default(uuid()) @db.Uuid
  itemId    String          @map("item_id") @db.Uuid
  kind      PayrollLineKind
  label     String
  amount    Int             // positif = menambah, negatif = memotong
  refId     String?         @map("ref_id") @db.Uuid // honor/loan/deduction id
  createdAt DateTime        @default(now()) @map("created_at")

  item PayrollItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("payroll_item_lines")
}

/**
 * Pencatatan honor BOS dari dinas.
 * Sertifikasi → hanya dicatat (uang langsung ke guru, bukan kas sekolah).
 * Non-sertifikasi → dibayar sekolah lewat payroll (masuk slip sebagai BOS_HONOR).
 */
model BosHonor {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  month       String   // "YYYY-MM"
  amount      Int
  certified   Boolean  @default(true) // sertifikasi = pencatatan saja
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month])
  @@map("bos_honors")
}

// ---------- Kesiswaan & Akademik ----------

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  DROPPED
}

enum EmployeeType {
  TEACHER // Guru
  TENDIK // Tenaga Kependidikan — jabatan di staffKind
  STAFF // legacy — baris lama dimigrasi ke TENDIK
  TU
  KESISWAAN
  KURIKULUM
  KEUANGAN
  SARPRAS
  LAYSUS
  PRINCIPAL // kepala sekolah
}

enum AttendanceStatus {
  PRESENT
  SICK
  PERMITTED
  ABSENT
}

enum AssessmentType {
  FORMATIF
  SUMATIF
  PTS
  PAS
}

model Student {
  id           String        @id @default(uuid()) @db.Uuid
  nis          String?       @unique
  nisn         String?       @unique
  nik          String?       // NIK siswa — dari pendaftaran / diisi TU nanti
  name         String
  gender       Gender?
  birthPlace   String?       @map("birth_place")
  birthDate    DateTime?     @map("birth_date") @db.Date
  address      String?
  status       StudentStatus @default(ACTIVE)
  candidateId  String?       @unique @map("candidate_id") @db.Uuid // link ke pendaftaran SPMB
  parentId     String?       @map("parent_id") @db.Uuid
  // ---- buku induk peserta didik ----
  previousSchool   String?  @map("previous_school") // pendidikan sebelumnya (SD asal)
  healthNotes      String?  @map("health_notes") // keterangan kesehatan
  fatherName       String?  @map("father_name")
  motherName       String?  @map("mother_name")
  parentOccupation String?  @map("parent_occupation")
  parentPhone      String?  @map("parent_phone")
  intelligenceNotes String? @map("intelligence_notes") // keterangan intelegensi
  leavingNotes     String?  @map("leaving_notes") // keterangan meninggalkan sekolah
  otherNotes       String?  @map("other_notes") // lain-lain
  recordDetails    Json?    @map("record_details") // kantong detail buku induk (32 item Dapodik)
  photoKey         String?  @map("photo_key") // pas foto buku induk (key storage)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at") // soft delete / arsip

  candidate    Candidate?    @relation(fields: [candidateId], references: [id])
  parent       User?         @relation("StudentParent", fields: [parentId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]
  invoices     Invoice[]
  savings      SavingsEntry[]
  attendances  AttendanceRecord[]
  achievements Achievement[]
  violations   Violation[]
  grades       Grade[]
  documents    Document[]
  answers      StudentAnswer[]
  examSeats    ExamSeat[]
  ekskulMemberships ExtracurricularMember[]

  @@index([status, name])
  @@map("students")
}

model Employee {
  id        String       @id @default(uuid()) @db.Uuid
  nip       String?      @unique
  name      String
  type      EmployeeType @default(TEACHER)
  // GTK model Dapodik — jabatan pokok tendik (TU/LAYSUS/SATPAM/KEPALA_SEKOLAH)
  staffKind      String? @map("staff_kind")
  // Tugas tambahan — WAKASEK_*/KEPALA_TU/BENDAHARA_*/OPERATOR_DAPODIK/dst
  additionalDuty String? @map("additional_duty")
  email     String?
  phone     String?
  address   String?
  photoUrl  String?      @map("photo_url") // foto profil pegawai (key storage)
  isActive  Boolean      @default(true) @map("is_active")
  userId    String?      @unique @map("user_id") @db.Uuid // optional login link
  // payroll
  payScaleId           String?  @map("pay_scale_id") @db.Uuid
  workStartDate        DateTime? @map("work_start_date") @db.Date // masa kerja → golongan
  weeklyRequiredMinutes Int     @default(0) @map("weekly_required_minutes") // jam wajib/minggu
  hourlyRate           Int?     @map("hourly_rate")     // override tarif/jam
  transportRate        Int?     @map("transport_rate")  // override transport/jam
  isCertified          Boolean  @default(false) @map("is_certified") // sertifikasi (BOS)
  fingerPin            String?  @unique @map("finger_pin") // user id di mesin absensi
  department           String?  // bidang: KURIKULUM|KESISWAAN|TATA_USAHA|KEUANGAN|HUMAS|LAINNYA
  isDeptHead           Boolean  @default(false) @map("is_dept_head") // kepala bidang
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  payScale    PayScale?            @relation(fields: [payScaleId], references: [id], onDelete: SetNull)
  homeroomFor Class[]              @relation("Homeroom")
  assignments TeachingAssignment[]
  attendances EmployeeAttendance[]
  honors      EmployeeHonor[]
  deductions  EmployeeDeduction[]
  loans       Loan[]
  payrollItems PayrollItem[]
  pensionEntries PensionEntry[]
  bosHonors   BosHonor[]
  attendanceLogs AttendanceLog[]
  shifts      EmployeeShift[]
  staffDocuments StaffDocument[]
  collectionItems DocCollectionItem[]
  coachedEkskul  Extracurricular[]

  @@index([type, name])
  @@map("employees")
}

model Curriculum {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique // e.g. "Kurikulum Merdeka"
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  subjects Subject[]

  @@map("curricula")
}

model Semester {
  id             String   @id @default(uuid()) @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  name           String // e.g. "Ganjil", "Genap"
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  isActive       Boolean  @default(false) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@unique([academicYearId, name])
  @@index([academicYearId])
  @@map("semesters")
}

model Subject {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique // e.g. "MTK"
  name         String
  curriculumId String? @map("curriculum_id") @db.Uuid
  gradeLevel   Int?    @map("grade_level") // 7/8/9
  createdAt    DateTime @default(now()) @map("created_at")

  curriculum  Curriculum?          @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  assignments TeachingAssignment[]
  assessments Assessment[]

  @@map("subjects")
}

model Class {
  id             String  @id @default(uuid()) @db.Uuid
  name           String // e.g. "7A"
  gradeLevel     Int     @map("grade_level")
  academicYearId String  @map("academic_year_id") @db.Uuid
  homeroomId     String? @map("homeroom_id") @db.Uuid
  capacity       Int?    @default(32)
  createdAt      DateTime @default(now()) @map("created_at")

  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id])
  homeroom     Employee?           @relation("Homeroom", fields: [homeroomId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]
  invoices     Invoice[]
  assignments  TeachingAssignment[]
  attendances  AttendanceRecord[]
  assessments  Assessment[]
  examSeats    ExamSeat[]

  @@unique([name, academicYearId])
  @@index([academicYearId])
  @@map("classes")
}

model Enrollment {
  id             String  @id @default(uuid()) @db.Uuid
  studentId      String  @map("student_id") @db.Uuid
  classId        String  @map("class_id") @db.Uuid
  academicYearId String  @map("academic_year_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, academicYearId])
  @@map("enrollments")
}

model TeachingAssignment {
  id             String  @id @default(uuid()) @db.Uuid
  employeeId     String  @map("employee_id") @db.Uuid
  subjectId      String  @map("subject_id") @db.Uuid
  classId        String  @map("class_id") @db.Uuid
  academicYearId String  @map("academic_year_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class        Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])
  schedules    ScheduleEntry[]

  @@unique([employeeId, subjectId, classId, academicYearId])
  @@map("teaching_assignments")
}

model ScheduleEntry {
  id           String  @id @default(uuid()) @db.Uuid
  assignmentId String  @map("assignment_id") @db.Uuid
  day          Int     @map("day_of_week") // 1=Senin … 6=Sabtu
  startMinute  Int     @map("start_minute") // menit sejak 00:00
  endMinute    Int     @map("end_minute")
  room         String?

  assignment TeachingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, day])
  @@map("schedule_entries")
}

model AttendanceRecord {
  id        String           @id @default(uuid()) @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  classId   String           @map("class_id") @db.Uuid
  date      DateTime         @db.Date
  status    AttendanceStatus
  note      String?
  takenBy   String?          @map("taken_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([classId, date])
  @@map("attendance_records")
}

model Achievement {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  title       String
  level       String? // e.g. "Kota", "Provinsi"
  year        Int?
  description String?
  evidenceDocumentId String? @map("evidence_document_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evidenceDocument Document? @relation("AchievementEvidence", fields: [evidenceDocumentId], references: [id], onDelete: SetNull)

  @@map("achievements")
}

model Violation {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  type        String
  description String?
  points      Int      @default(0)
  date        DateTime @db.Date
  evidenceDocumentId String? @map("evidence_document_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evidenceDocument Document? @relation("ViolationEvidence", fields: [evidenceDocumentId], references: [id], onDelete: SetNull)

  @@map("violations")
}

/** Ekstrakurikuler — dikelola kesiswaan. */
model Extracurricular {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  coachId     String?  @map("coach_id") @db.Uuid // pembina — pegawai
  schedule    String?  // mis. "Jumat 15.30"
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  coach   Employee?                 @relation(fields: [coachId], references: [id], onDelete: SetNull)
  members ExtracurricularMember[]

  @@map("extracurriculars")
}

/** Opsi GTK yang bisa dikelola admin — jabatan tendik & tugas tambahan. */
model GtkOption {
  id         String   @id @default(uuid()) @db.Uuid
  group      String   // 'STAFF_KIND' (jabatan tendik) | 'DUTY' (tugas tambahan)
  code       String   // kode unik per group — disimpan di employees.staff_kind/additional_duty
  label      String   // label tampilan
  department String?  // bidang turunan — null = ikuti jabatan/jenis
  isHead     Boolean  @default(false) @map("is_head") // tugas kepala bidang
  roleKey    String?  @map("role_key") // role akun bila dibuatkan login — null = fallback bawaan
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([group, code])
  @@map("gtk_options")
}

model ExtracurricularMember {
  id                 String   @id @default(uuid()) @db.Uuid
  extracurricularId  String   @map("extracurricular_id") @db.Uuid
  studentId          String   @map("student_id") @db.Uuid
  role               String?  // pengurus: ketua/sekretaris/dst
  joinedAt           DateTime @default(now()) @map("joined_at")

  extracurricular Extracurricular @relation(fields: [extracurricularId], references: [id], onDelete: Cascade)
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([extracurricularId, studentId])
  @@map("extracurricular_members")
}

model Assessment {
  id             String         @id @default(uuid()) @db.Uuid
  subjectId      String         @map("subject_id") @db.Uuid
  classId        String?        @map("class_id") @db.Uuid
  academicYearId String         @map("academic_year_id") @db.Uuid
  name           String // e.g. "Sumatif Bab 1"
  type           AssessmentType
  maxScore       Int            @default(100) @map("max_score")
  createdAt      DateTime       @default(now()) @map("created_at")

  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class        Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  grades       Grade[]
  questions    AssessmentQuestion[]

  @@map("assessments")
}

model Grade {
  id           String  @id @default(uuid()) @db.Uuid
  assessmentId String  @map("assessment_id") @db.Uuid
  studentId    String  @map("student_id") @db.Uuid
  score        Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@map("grades")
}

// ---------- Tata Usaha (surat menyurat, mutasi, ujian sekolah) ----------

enum LetterDirection {
  IN
  OUT
}

enum MutationDirection {
  IN
  OUT
}

enum MutationStatus {
  PROCESS
  DONE
  CANCELLED
}

enum ExamPeriod {
  US1
  US2
}

enum ExamResult {
  PENDING
  PASSED
  FAILED
}

/** Agenda surat masuk/keluar — registrasi TU dengan lampiran opsional. */
/** Kategori agenda surat & mutasi — TU bisa menambah sendiri. */
model LetterCategory {
  id     String @id @default(uuid()) @db.Uuid
  kind   String // SURAT | MUTASI
  name   String
  createdAt DateTime @default(now()) @map("created_at")

  letters   Letter[]
  mutations StudentMutation[]

  @@unique([kind, name])
  @@map("letter_categories")
}

model Letter {
  id          String          @id @default(uuid()) @db.Uuid
  direction   LetterDirection
  number      String // nomor surat (agenda)
  date        DateTime        @db.Date
  subject     String // perihal
  party       String? // pengirim (masuk) / tujuan (keluar)
  categoryId  String?         @map("category_id") @db.Uuid
  category    LetterCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description String?
  storageKey  String?         @map("storage_key")
  fileName    String?         @map("file_name")
  mimeType    String?         @map("mime_type")
  createdBy   String?         @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([direction, number])
  @@index([direction, date])
  @@map("letters")
}

/** Mutasi siswa masuk/keluar — register perpindahan antar sekolah. */
model StudentMutation {
  id           String            @id @default(uuid()) @db.Uuid
  direction    MutationDirection
  studentName  String            @map("student_name")
  nisn         String?
  date         DateTime          @db.Date
  school       String? // asal (mutasi masuk) / tujuan (mutasi keluar)
  letterNumber String?           @map("letter_number") // no. surat mutasi
  categoryId   String?           @map("category_id") @db.Uuid
  category     LetterCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  storageKey   String?           @map("storage_key") // surat mutasi/keterangan terima
  fileName     String?           @map("file_name")
  mimeType     String?           @map("mime_type")
  status       MutationStatus    @default(PROCESS)
  notes        String?
  createdBy    String?           @map("created_by") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([direction, date])
  @@map("student_mutations")
}

/** Catatan hasil Ujian Sekolah 1 & 2 per siswa per tahun ajaran. */
model SchoolExamRecord {
  id             String        @id @default(uuid()) @db.Uuid
  period         ExamPeriod
  academicYearId String        @map("academic_year_id") @db.Uuid
  studentName    String        @map("student_name")
  nisn           String?
  score          Int?
  result         ExamResult    @default(PENDING)
  notes          String?
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([period, academicYearId])
  @@map("school_exam_records")
}

// ---------- Files, notifications, audit ----------

model Document {
  id         String   @id @default(uuid()) @db.Uuid
  ownerId    String?  @map("owner_id") @db.Uuid
  type       String // e.g. "registration.form", "payment.proof" — values defined per module
  storageKey String   @map("storage_key") // S3 object key
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  registrationId String? @map("registration_id") @db.Uuid
  studentId    String?  @map("student_id") @db.Uuid
  verifiedBy String?  @map("verified_by") @db.Uuid
  verifiedAt DateTime? @map("verified_at")
  verificationNote String? @map("verification_note")
  createdAt  DateTime @default(now()) @map("created_at")

  owner    User?  @relation("OwnedDocuments", fields: [ownerId], references: [id], onDelete: SetNull)
  uploader User?  @relation("UploadedDocuments", fields: [uploadedBy], references: [id], onDelete: SetNull)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  student      Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  paymentProofs  Payment[]   @relation("PaymentProof")
  achievementEvidence Achievement[] @relation("AchievementEvidence")
  violationEvidence   Violation[]   @relation("ViolationEvidence")

  @@index([ownerId])
  @@index([registrationId])
  @@index([studentId])
  @@map("documents")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  channel   String    @default("in_app")
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String // e.g. "auth.login", "academic-year.create"
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------- WhatsApp gateway (antrean anti-spam) ----------

enum WhatsappMessageStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

model WhatsappSetting {
  id              String   @id @default("whatsapp")
  enabled         Boolean  @default(false)
  gatewayUrl      String   @map("gateway_url")
  gatewayToken    String?  @map("gateway_token")
  intervalSeconds Int      @default(8) @map("interval_seconds") // jeda antar pesan
  dailyLimit      Int      @default(200) @map("daily_limit")
  updatedBy       String?  @map("updated_by") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_settings")
}

model WhatsappMessage {
  id        String                @id @default(uuid()) @db.Uuid
  type      String // kategori antrean — e.g. "titipan_code" (filterable)
  phone     String // tujuan 62xxx
  message   String
  status    WhatsappMessageStatus @default(QUEUED)
  attempts  Int                   @default(0)
  lastError String?               @map("last_error")
  sentAt    DateTime?             @map("sent_at")
  refType   String?               @map("ref_type") // e.g. "titipan_entry"
  refId     String?               @map("ref_id") @db.Uuid
  createdBy String?               @map("created_by") @db.Uuid
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([type, status])
  @@map("whatsapp_messages")
}

// ---------- Jadwal non-mapel: ishoma, pembiasaan, istirahat, upacara ----------

/** Blok jadwal non-pembelajaran — rutin mingguan (day) atau tanggal spesifik (date). */
model ScheduleBlock {
  id             String   @id @default(uuid()) @db.Uuid
  label          String // "Ishoma", "Pembiasaan", "Istirahat", "Upacara"
  day            Int?     @map("day_of_week") // 1=Senin…7=Minggu — rutin tiap minggu
  date           DateTime? @db.Date // tanggal spesifik bila bukan rutin
  startMinute    Int      @map("start_minute")
  endMinute      Int      @map("end_minute")
  academicYearId String   @map("academic_year_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([academicYearId, day])
  @@map("schedule_blocks")
}

// ---------- Asesmen: butir soal & jawaban siswa ----------

enum QuestionType {
  MCQ          // pilihan ganda
  MCQ_COMPLEX  // pilihan ganda kompleks (multi jawaban benar)
  TRUE_FALSE   // benar/salah
  MATCHING     // menjodohkan
}

/** Butir soal per asesmen — kunci + bobot untuk analisis. */
model AssessmentQuestion {
  id           String       @id @default(uuid()) @db.Uuid
  assessmentId String       @map("assessment_id") @db.Uuid
  number       Int // nomor soal
  type         QuestionType @default(MCQ)
  weight       Int          @default(1) // bobot nilai
  key          Json? // kunci jawaban (index benar / pasangan menjodohkan)
  prompt       String? // teks soal singkat opsional

  assessment Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers    StudentAnswer[]

  @@unique([assessmentId, number])
  @@map("assessment_questions")
}

/** Jawaban siswa per butir soal — untuk rekap & analisis butir. */
model StudentAnswer {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  answer     Json? // jawaban siswa (index(es) dipilih)
  score      Int      @default(0) // skor diperoleh (setelah bobot)
  isCorrect  Boolean? @map("is_correct")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student  Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([questionId, studentId])
  @@index([studentId])
  @@map("student_answers")
}

// ---------- Dokumen staf: administrasi guru, SK, koleksi kisi-kisi ----------

/** Dokumen administrasi guru/pegawai — SK, ijazah, perangkat pembelajaran, dll. */
model StaffDocument {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  category   String // "SK", "IJAZAH", "ADMINISTRASI", "PERANGKAT", "LAINNYA"
  title      String
  storageKey String   @map("storage_key")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, category])
  @@map("staff_documents")
}

/** Batch pengumpulan dokumen dari kurikulum — e.g. kisi-kisi Sumatif Semester 1. */
model DocCollection {
  id             String    @id @default(uuid()) @db.Uuid
  title          String // "Kisi-kisi Sumatif Semester Ganjil 2026"
  category       String    @default("KISI_KISI") // jenis dokumen yang dikumpulkan
  description    String?
  deadlineAt     DateTime? @map("deadline_at")
  academicYearId String?   @map("academic_year_id") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  notifiedAt     DateTime? @map("notified_at") // kapan WA broadcast dikirim

  items DocCollectionItem[]

  @@map("doc_collections")
}

model DocCollectionItem {
  id           String    @id @default(uuid()) @db.Uuid
  collectionId String    @map("collection_id") @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  submittedAt  DateTime? @map("submitted_at")
  fileName     String?   @map("file_name")
  storageKey   String?   @map("storage_key")
  mimeType     String?   @map("mime_type")
  sizeBytes    Int?      @map("size_bytes")
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at")

  collection DocCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([collectionId, employeeId])
  @@map("doc_collection_items")
}

// ---------- Pengajuan program/RKS per bidang → persetujuan KS ----------

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

/** Pengajuan RKS / program kerja / rencana & realisasi kegiatan — diajukan bidang, disetujui KS, terlihat bendahara. */
model ProgramSubmission {
  id          String           @id @default(uuid()) @db.Uuid
  department  String // bidang pengaju: KURIKULUM|KESISWAAN|TATA_USAHA|KEUANGAN|HUMAS|LAINNYA
  kind        String // "RKS", "PROKER", "RENCANA", "REALISASI"
  title       String
  description String?
  rab         Json? // [{ name, qty, unit, price, amount }]
  amountTotal Int              @default(0) @map("amount_total")
  storageKey  String?          @map("storage_key")
  fileName    String?          @map("file_name")
  status      SubmissionStatus @default(PENDING)
  submittedBy String           @map("submitted_by") @db.Uuid
  reviewedBy  String?          @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime?        @map("reviewed_at")
  reviewNote  String?          @map("review_note")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([department, status])
  @@map("program_submissions")
}

// ---------- Arsip TU ----------

model ArchiveCategory {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique
  createdAt DateTime      @default(now()) @map("created_at")
  items     ArchiveItem[]

  @@map("archive_categories")
}

model ArchiveItem {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String?  @map("category_id") @db.Uuid
  title      String
  refNumber  String?  @map("ref_number") // nomor dokumen/arsip
  date       DateTime? @db.Date
  storageKey String   @map("storage_key")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  category ArchiveCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId, date])
  @@map("archive_items")
}

// ---------- Tata tertib, template & jadwal seragam PTK ----------

/** Dokumen kebijakan/template — tata tertib siswa/PTK, form mutasi, contoh surat — dikelola kurikulum/TU. */
model PolicyDocument {
  id         String   @id @default(uuid()) @db.Uuid
  kind       String // "TATA_TERTIB_SISWA","TATA_TERTIB_PTK","SERAGAM","FORM_MUTASI_MASUK","FORM_MUTASI_KELUAR","LAINNYA"
  title      String
  storageKey String   @map("storage_key")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([kind])
  @@map("policy_documents")
}

/** Jadwal seragam PTK per hari — terlihat semua pegawai. */
model UniformSchedule {
  id    String  @id @default(uuid()) @db.Uuid
  day   Int     @unique // 1=Senin…7=Minggu
  name  String // "Putih Abu-abu", "Batik", "Pramuka", "Olahraga"
  note  String?

  @@map("uniform_schedules")
}

// ---------- Ruang & kursi ujian → kartu peserta ---------

/** Ruang ujian per periode — untuk cetak kartu peserta & denah per rombel. */
model ExamRoom {
  id             String  @id @default(uuid()) @db.Uuid
  name           String // "Ruang 1 / Lab IPA"
  period         String // label periode ujian, e.g. "US 2026" / "PTS Ganjil"
  academicYearId String  @map("academic_year_id") @db.Uuid
  capacity       Int     @default(24)
  createdAt      DateTime @default(now()) @map("created_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  seats        ExamSeat[]

  @@unique([name, period, academicYearId])
  @@map("exam_rooms")
}

model ExamSeat {
  id        String  @id @default(uuid()) @db.Uuid
  roomId    String  @map("room_id") @db.Uuid
  studentId String  @map("student_id") @db.Uuid
  classId   String? @map("class_id") @db.Uuid
  seatNo    Int?    @map("seat_no")

  room    ExamRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@unique([roomId, studentId])
  @@index([classId])
  @@map("exam_seats")
}

// ================= Sarpras — sarana & prasarana (fasilitas) =================

/** Jenis sarana yang dikelola TU — Meja Siswa, Kursi Siswa, dst (mirip GtkOption). */
model SaranaType {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  label     String
  isActive  Boolean      @default(true) @map("is_active")
  sortOrder Int          @default(0) @map("sort_order")
  items     SaranaItem[]

  @@map("sarana_types")
}

/** Baris inventaris sarana — sesuai ekspor Dapodik (jenis/letak/kepemilikan/spesifikasi/jumlah/laik/tidak laik). */
model SaranaItem {
  id        String     @id @default(uuid()) @db.Uuid
  typeId    String     @map("type_id") @db.Uuid
  location  String?    // letak — nama rombel (dipilih dari data kelas) atau teks bebas
  ownership String?    // kepemilikan — Milik / Bukan Milik / dst
  spec      String?    // spesifikasi barang
  qty       Int        @default(0) // jumlah
  good      Int        @default(0) // laik
  bad       Int        @default(0) // tidak laik
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  type      SaranaType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([typeId])
  @@map("sarana_items")
}

/** Prasarana — ruang/bangunan: kelas, perpus, wc, lab; ukuran & status kepemilikan. */
model Prasarana {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  note      String?   // keterangan
  length    Float?    // panjang (meter)
  width     Float?    // lebar (meter)
  ownership String?   // status kepemilikan — Milik / Sewa / Hibah / dst
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("prasaranas")
}
