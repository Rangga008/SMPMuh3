{
  "name": "smpmuh3-platform",
  "version": "0.0.0",
  "private": true,
  "description": "School platform for SMP Muhammadiyah 3 Kota Bandung",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infrastructure/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
